{
  "schema_version": "1.0",
  "table": "catalysis_experiments",
  "description": "Synthetic rare-earth and transition-metal catalyst performance dataset. Values are illustrative; do not cite as experimental observations.",
  "columns": [
    {"name": "catalyst_id",             "type": "STRING",  "description": "Unique run identifier (e.g. CER-001)"},
    {"name": "catalyst_name",           "type": "STRING",  "description": "Human-readable catalyst label"},
    {"name": "active_metal",            "type": "STRING",  "description": "Primary catalytic metal or None for bare supports"},
    {"name": "support",                 "type": "STRING",  "description": "Oxide support material"},
    {"name": "metal_loading_wt_pct",    "type": "FLOAT",   "description": "Active-metal weight loading (wt%)"},
    {"name": "promoter",                "type": "STRING",  "description": "Promoter element or None"},
    {"name": "promoter_loading_wt_pct", "type": "FLOAT",   "description": "Promoter weight loading (wt%); null when absent"},
    {"name": "bet_surface_area_m2g",    "type": "FLOAT",   "description": "BET surface area (m2/g)"},
    {"name": "synthesis_method",        "type": "STRING",  "description": "Catalyst preparation route"},
    {"name": "calcination_temp_c",      "type": "INTEGER", "description": "Calcination temperature (deg C)"},
    {"name": "reaction",                "type": "STRING",  "description": "Target reaction identifier"},
    {"name": "reaction_temp_c",         "type": "INTEGER", "description": "Reaction temperature (deg C)"},
    {"name": "pressure_bar",            "type": "FLOAT",   "description": "Total reactor pressure (bar)"},
    {"name": "ghsv_h",                  "type": "FLOAT",   "description": "Gas hourly space velocity (h-1)"},
    {"name": "conversion_pct",          "type": "FLOAT",   "description": "Reactant conversion (mol%)"},
    {"name": "selectivity_pct",         "type": "FLOAT",   "description": "Target-product selectivity (mol%)"},
    {"name": "tof_s",                   "type": "FLOAT",   "description": "Turnover frequency based on metal dispersion (s-1)"},
    {"name": "stability_hours",         "type": "FLOAT",   "description": "Time on stream without >10% conversion drop (h)"},
    {"name": "dispersion_pct",          "type": "FLOAT",   "description": "Metal dispersion from CO chemisorption (%)"}
  ],
