{
  "formats": [
    {
      "name": "canonical_catalyst",
      "pattern": "\\b(?P<identifier>[A-Z]{2,3}-\\d{3})\\b",
      "predicates": [
        {"field": "catalyst_id", "capture": "identifier"}
      ]
    },
    {
      "name": "metal_on_support",
      "pattern": "\\b(?P<pct>[0-9]+(?:\\.[0-9]+)?)\\s*(?:wt[%.]?|%)\\s*(?P<metal>Pd|Pt|Rh|Ru|Ni|Au|Cu)/(?P<support>CeO2|Al2O3|ZrO2|TiO2|La2O3|SiO2)\\b",
      "predicates": [
        {"field": "active_metal",         "capture": "metal"},
        {"field": "support",              "capture": "support"},
        {"field": "metal_loading_wt_pct", "capture": "pct"}
      ]
    }
  ]
}
