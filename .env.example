# Copy this file to .env and fill in your key.
# The demo uses Anthropic's API for planning, synthesis, and verification.

ANTHROPIC_API_KEY=sk-ant-...

# Optional: override the models used by the demo.
# Defaults: claude-sonnet-4-5 for planning/synthesis, claude-haiku-4-5-20251001 for verification.
# ANTHROPIC_MODEL=claude-sonnet-4-5
# VERIFIER_MODEL=claude-haiku-4-5-20251001
